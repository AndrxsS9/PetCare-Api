# PetCare API - end-to-end test configuration (placeholders only).
#
# Copy this file to .env.e2e (git-ignored) and fill it in. It is read ONLY by
# `npm run test:e2e`; the application and the unit tests never use it, and the
# e2e suite never reads database values from .env.
#
# WARNING: the e2e suite WRITES to this database. On start it creates/updates
# the schema with TypeORM synchronize, then inserts and deletes its own test
# records. Use a dedicated, disposable database. Never point it at the
# development or production database.

E2E_DB_HOST=localhost
E2E_DB_PORT=5432
E2E_DB_USERNAME=your_test_db_user
E2E_DB_PASSWORD=your_test_db_password

# Must be "petcare_test" (or "petcare_test_<suffix>") and different from
# DB_NAME in .env.
E2E_DB_NAME=petcare_test

# Safety confirmation: repeat E2E_DB_NAME exactly to confirm the database is
# disposable. The suite refuses to start otherwise.
E2E_DB_CONFIRM=

E2E_DB_SSL=false

# Only local hosts are accepted. Set to true ONLY for a dedicated remote test
# server (for example a CI container).
E2E_ALLOW_REMOTE_DB=false

# JWT secret used by the app under test (at least 32 random characters).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
E2E_JWT_SECRET=
