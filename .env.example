# Application
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=petcare_db

# TypeORM Configuration
# Set DB_SYNCHRONIZE=false in production environments
DB_SYNCHRONIZE=true
DB_LOGGING=false
DB_SSL=false

# JWT Authentication
# REQUIRED. The API refuses to start if JWT_SECRET is missing, shorter than
# 32 characters or looks like a placeholder. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access-token lifetime in seconds (60-86400). Default: 3600 (1 hour).
JWT_EXPIRES_IN=3600
